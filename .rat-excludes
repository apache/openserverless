#
# Files excluded from the Apache RAT license-header audit.
#
# JSON has no comment syntax, so an ASF license header cannot be embedded
# in a .json file without making it invalid. Such files are exempt under
# the ASF policy on files that cannot carry a header.
#
# Pattern syntax is that of --input-exclude-file (gitignore-style).

# bun.lock is JSON-formatted - a license header would make it invalid.
**/bun.lock

# go.sum is a generated checksum database - a header breaks verification.
**/go.sum

# skip WARN
**/WARN

# skip .git
**/.git

# skip the skip
no-release.txt
